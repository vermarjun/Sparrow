{
  "name": "sparrow",
  "version": "0.1.0",
  "description": "One captain, three harnesses. Hire Claude Code, Codex and OpenCode agents into real terminals, talk to them over one protocol, and get results with evidence.",
  "type": "module",
  "private": true,
  "bin": {
    "sparrow": "bin/sparrow"
  },
  "scripts": {
    "sparrow": "bun bin/sparrow",
    "test": "bun test test/",
    "typecheck": "tsc --noEmit -p .",
    "web:dev": "cd web && bun run dev",
    "web:build": "cd web && bun run build",
    "build:binary": "bun scripts/build-binary.ts",
    "build:binary:all": "bun scripts/build-binary.ts --target all",
    "smoke:binary": "bun scripts/smoke-binary.ts",
    "build:npm": "bun scripts/build-npm.ts",
    "release:local": "sh scripts/release-local.sh",
    "test:packaging": "bun test npm/packaging.test.ts"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "bun-types": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "ai-agents",
    "coding-agents",
    "multi-agent",
    "agent-orchestration",
    "orchestrator",
    "subagents",
    "tmux",
    "cli",
    "developer-tools",
    "llm",
    "agentic-coding"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vermarjun/Sparrow.git"
  },
  "homepage": "https://github.com/vermarjun/Sparrow#readme",
  "bugs": {
    "url": "https://github.com/vermarjun/Sparrow/issues"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
